{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "*.ts", "*.js", "*.json", "public/**"],
      "outputs": [".output/**", "dist/**"],
      "outputLogs": "new-only"
    },
    "dev": {
      "persistent": true,
      "cache": false
    }
  },
  "ui": "stream"
}